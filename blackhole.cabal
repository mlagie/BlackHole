cabal-version:      2.4
name:               blackhole
version:            0.12.5.0
synopsis:           Archiveur hybride Zstandard et mathematique sans perte
build-type:         Simple
license:            MIT
extra-source-files:
  README.md
  WINDOWS.md
  VALIDATION-PERFORMANCE.md
  build-windows.ps1
  install-windows-context-menu.ps1
  blackhole-progress.ps1
  install-fedora.sh
  test/*.sh
  test/*.py
  test/native-transforms.c
  bench/*.sh
  bench/*.hs
  bench/*.json
  .github/workflows/build.yml
  vendor/zstd/LICENSE
  vendor/zstd/COPYING
  vendor/zstd/ORIGIN.md
  vendor/zstd/lib/*.h
  vendor/zstd/lib/common/*.h
  vendor/zstd/lib/compress/*.h
  vendor/zstd/lib/decompress/*.h

common options
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  build-depends:    base >=4.14 && <5, bytestring, binary, containers, directory >=1.3.6, filepath, process

flag bundled-zstd
  description: Build the bundled Zstandard C sources (always used on Windows)
  default: False
  manual: True

flag windows-check
  description: Exercise the portable Windows branch on Linux (development only)
  default: False
  manual: True

library
  import:           options
  hs-source-dirs:   src
  exposed-modules:  BlackHole.Engine, BlackHole.Archive, BlackHole.Chunking, BlackHole.Delta, BlackHole.PortablePaths
  other-modules:  BlackHole.Zstd, BlackHole.Transform, BlackHole.Hash, BlackHole.Platform, BlackHole.Diagnostics
  c-sources:     cbits/normalize.c, cbits/words.c, cbits/hash.c, cbits/windows.c
  cc-options:    -O3 -Wall -Wextra
  if !os(windows) && !flag(windows-check)
    build-depends: unix
  if flag(windows-check)
    cpp-options: -DBLACKHOLE_WINDOWS_TEST
  if os(windows)
    extra-libraries: kernel32
  if os(windows) || flag(bundled-zstd)
    include-dirs: vendor/zstd/lib
    cc-options: -DZSTD_MULTITHREAD -DZSTD_DISABLE_ASM -DZSTD_LEGACY_SUPPORT=0
    c-sources:
      vendor/zstd/lib/common/debug.c
      vendor/zstd/lib/common/entropy_common.c
      vendor/zstd/lib/common/error_private.c
      vendor/zstd/lib/common/fse_decompress.c
      vendor/zstd/lib/common/pool.c
      vendor/zstd/lib/common/threading.c
      vendor/zstd/lib/common/xxhash.c
      vendor/zstd/lib/common/zstd_common.c
      vendor/zstd/lib/compress/fse_compress.c
      vendor/zstd/lib/compress/hist.c
      vendor/zstd/lib/compress/huf_compress.c
      vendor/zstd/lib/compress/zstd_compress.c
      vendor/zstd/lib/compress/zstd_compress_literals.c
      vendor/zstd/lib/compress/zstd_compress_sequences.c
      vendor/zstd/lib/compress/zstd_compress_superblock.c
      vendor/zstd/lib/compress/zstd_double_fast.c
      vendor/zstd/lib/compress/zstd_fast.c
      vendor/zstd/lib/compress/zstd_lazy.c
      vendor/zstd/lib/compress/zstd_ldm.c
      vendor/zstd/lib/compress/zstd_opt.c
      vendor/zstd/lib/compress/zstd_preSplit.c
      vendor/zstd/lib/compress/zstdmt_compress.c
      vendor/zstd/lib/decompress/huf_decompress.c
      vendor/zstd/lib/decompress/zstd_ddict.c
      vendor/zstd/lib/decompress/zstd_decompress.c
      vendor/zstd/lib/decompress/zstd_decompress_block.c
    if !os(windows)
      extra-libraries: pthread
  else
    extra-libraries: zstd

executable blackhole
  import:           options
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    blackhole

test-suite blackhole-test
  import:           options
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    blackhole

  if !os(windows) && !flag(windows-check)
    build-depends: unix
  if flag(windows-check)
    cpp-options: -DBLACKHOLE_WINDOWS_TEST
